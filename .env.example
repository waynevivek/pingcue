# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional alternative if using Supabase's newer publishable key format:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=PingCue <reminders@yourdomain.com>
# RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Daily Cron Protection & Monitoring (generate a random 32+ char string)
CRON_SECRET=replace-with-random-secret-at-least-16-chars
# CRON_ALERT_EMAIL=alerts@yourdomain.com
# CRON_HEARTBEAT_URL=https://hc-ping.com/your-uuid

# Dodo Payments (start in test_mode, switch to live_mode after verification)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_FOUNDING_PASS_PRODUCT_ID=pdt_your-product-id

# SEO, Search Console Verification, IndexNow & Optional Analytics
# GOOGLE_SITE_VERIFICATION=your-google-search-console-html-tag-token
# BING_SITE_VERIFICATION=your-bing-webmaster-msvalidate-token
# YANDEX_SITE_VERIFICATION=your-yandex-verification-token
# INDEXNOW_API_KEY=generate-a-32-char-alphanumeric-key
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=yourclarityid
# NEXT_PUBLIC_SOCIAL_LINKS=https://github.com/waynevivek/pingcue,https://x.com/yourhandle
# NEXT_PUBLIC_TWITTER_HANDLE=@yourhandle
# NEXT_PUBLIC_ALLOW_INDEXING=true
