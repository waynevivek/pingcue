# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional alternative if using Supabase's newer publishable key format:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=PingCue <reminders@yourdomain.com>

# Daily Cron Protection (generate a random 32+ char string)
CRON_SECRET=replace-with-random-secret-at-least-16-chars

# Dodo Payments (start in test_mode, switch to live_mode after verification)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_FOUNDING_PASS_PRODUCT_ID=pdt_your-product-id
